# Copie para .env e preencha (o .env nunca vai para o GitHub). Na hospedagem, estas mesmas variáveis vão no painel.

# Primeiro administrador: criado só na primeira vez que o servidor sobe com o banco vazio.
# Depois de entrar, troque a senha em "Minha conta" e pode apagar ADMIN_SENHA_INICIAL.
ADMIN_EMAIL=voce@exemplo.com
ADMIN_SENHA_INICIAL=troque-esta-senha-123
ADMIN_NOME=Seu nome

# Endereço público do site (https://...). Usado nos links de convite. No Render é preenchido sozinho.
URL_PUBLICA=
# Para o docker-compose.yml com HTTPS automático:
DOMINIO=casa.exemplo.com.br

# Opcional: liga o Claude (medidas e preços dos móveis, leitura da imagem da planta). Paga por uso na conta da Anthropic.
ANTHROPIC_API_KEY=
# CLAUDE_MODELO=claude-opus-5-5
# CLAUDE_LIMITE_HORA=30      pedidos por pessoa por hora
# CLAUDE_LIMITE_DIA=300      pedidos de todo mundo por dia

# Outras (valores padrão entre parênteses)
# PORT=3000
# DATA_DIR=./dados-servidor   pasta do banco e das cópias de segurança (no contêiner: /dados)
# SESSAO_DIAS=30              quanto tempo fica logado sem usar
# BACKUP_DIAS=14              quantas cópias diárias guardar
# IMPORTAR_CASA_975=1         na primeira vez, cria o projeto Casa 975 com os móveis de dados/
# COOKIE_SEGURO=1             só em produção (HTTPS); em casa, sem HTTPS, use 0
